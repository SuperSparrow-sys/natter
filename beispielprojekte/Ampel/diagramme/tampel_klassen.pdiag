{
  "format": "pdiag/1",
  "type": "class",
  "name": "TAmpel",
  "page": {
    "size": "A4",
    "orientation": "landscape"
  },
  "style": "modern-light",
  "shapes": [
    {
      "id": "s1",
      "kind": "class",
      "x": 168,
      "y": 136,
      "w": 332,
      "h": 160,
      "text": {
        "attributes": [
          "-__eingeschaltet: bool",
          "-__zustand: int"
        ],
        "methods": [
          "+__init__(eingeschaltet: bool, zustand: int)",
          "+einschalten()",
          "+ausschalten()",
          "+umschalten()",
          "+get_zustand(): int",
          "+get_eingeschaltet(): bool"
        ],
        "name": "Ampel"
      }
    },
    {
      "id": "s2",
      "kind": "class",
      "x": 808,
      "y": 136,
      "w": 220,
      "h": 160,
      "text": {
        "attributes": [
          "-ampel: Ampel",
          "-s_rot: Shape",
          "-s_gelb: Shape",
          "-s_gruen: Shape"
        ],
        "methods": [
          "+b_einschalten_click(sender)",
          "+b_wechseln_click(sender)",
          "+b_auschalten_click(sender)",
          "+ampel_zeichnen()"
        ],
        "name": "Form1"
      }
    },
    {
      "id": "s3",
      "kind": "note",
      "x": 256,
      "y": 560,
      "w": 240,
      "h": 104,
      "text": {
        "name": "Zustand: 1=grün, 2=gelb, 3=rot, 4=gelb (umschalten rechnet zustand % 4 + 1)"
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "kind": "aggregation",
      "from": "s2",
      "to": "s1",
      "labels": {
        "from": "1",
        "to": "1"
      }
    }
  ]
}
