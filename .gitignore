# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Virtuelle Umgebungen / uv
.venv/
venv/
uv.lock.tmp

# Build-/Paketausgabe
dist/
build_out/
runtime/
*.zip
# PyInstaller-Zwischenstände (ide/export/exporter.py, tools/ide_paketieren.py)
# - werden nach einem erfolgreichen Bau automatisch entfernt, aber bei
# einem abgebrochenen/abgestürzten Bau bleiben sie sonst als
# Repo-Müll liegen (real passiert, siehe Session-Historie).
_pyinstaller_build*/
_pyinstaller_spec*/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Natter-spezifisch
*.natter-session
# Laufzeit-Datenbanken, die gui_db-Beispielprojekte beim echten Start
# selbst anlegen (z. B. beispielprojekte/Kontoverwaltung/konten.sqlite) -
# kein eingecheckter Inhalt, sonst kopieren Tests versehentlich echte,
# durch manuelles Ausprobieren veränderte Datenbankstände statt eines
# frischen Zustands.
*.sqlite
*.sqlite3
prototypes/s2_monaco_jedi/monaco/
web/monaco/
prototypes/s6_signatur/*.pem
prototypes/s6_signatur/*.pfx
# Privater Signaturschlüssel (tools/signieren/README.md) - niemals
# committen, wer ihn hat kann im Namen von "Natter" signieren. Der
# öffentliche Teil (*.cer) ist dagegen unbedenklich und bewusst NICHT
# hier gelistet, damit er versioniert werden kann.
tools/signieren/*.pfx
tools/signieren/*.pfx.passwort.txt
prototypes/s6_signatur/manifest.signiert.json

# Lazarus-Referenzprojekte (referenz/): nur Quelltext + Bilder, keine
# Kompilate/Sessiondaten (sonst mehrere hundert MB)
referenz/**/lib/
referenz/**/backup/
referenz/**/*.exe
referenz/**/*.res
referenz/**/*.lps
