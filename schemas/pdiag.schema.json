{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://natter.local/schemas/pdiag.schema.json",
  "title": "Natter Diagrammdatei (.pdiag)",
  "description": "UML-Diagramme, Struktogramme und Entscheidungstabellen. Siehe konzept-natter.md, Abschnitt 13.7. Formen-Diagramme (class/use_case/activity/state/sequence) nutzen shapes+connectors, Struktogramme einen Blockbaum (root), Entscheidungstabellen Bedingungs-/Aktionszeilen mit Regel-Spalten.",
  "type": "object",
  "required": ["format", "type", "page", "style"],
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "struktogramm" } }, "required": ["type"] },
      "then": { "required": ["root"] }
    },
    {
      "if": {
        "properties": { "type": { "const": "entscheidungstabelle" } },
        "required": ["type"]
      },
      "then": { "required": ["conditions", "actions"] }
    }
  ],
  "properties": {
    "format": { "const": "pdiag/1" },
    "type": {
      "enum": ["class", "use_case", "activity", "state", "sequence", "struktogramm", "entscheidungstabelle"]
    },
    "name": {
      "type": "string",
      "description": "Anzeigename, z. B. Name des Struktogramms/Unterprogramms (Abschnitt 13.5)."
    },
    "root": {
      "$ref": "#/$defs/block",
      "description": "Wurzelblock eines Struktogramms (immer kind=sequence)."
    },
    "conditions": {
      "type": "array",
      "items": { "$ref": "#/$defs/tabellenzeile" },
      "description": "Bedingungsteil einer Entscheidungstabelle (Werte J/N/*/leer)."
    },
    "actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/tabellenzeile" },
      "description": "Aktionsteil einer Entscheidungstabelle (Werte X/leer)."
    },
    "page": {
      "type": "object",
      "required": ["size", "orientation"],
      "properties": {
        "size": { "type": "string", "examples": ["A4"] },
        "orientation": { "enum": ["portrait", "landscape"] }
      }
    },
    "style": { "enum": ["modern-light", "modern-dark", "black-white"] },
    "shapes": {
      "type": "array",
      "items": { "$ref": "#/$defs/shape" }
    },
    "connectors": {
      "type": "array",
      "items": { "$ref": "#/$defs/connector" }
    }
  },
  "$defs": {
    "block": {
      "type": "object",
      "required": ["id", "kind"],
      "description": "Struktogramm-Block (Nassi-Shneiderman, Abschnitt 13.5). Verschachtelung über children/then/else/cases statt über Koordinaten.",
      "properties": {
        "id": { "type": "string" },
        "kind": {
          "enum": [
            "sequence",
            "statement",
            "branch",
            "multi_branch",
            "count_loop",
            "head_loop",
            "foot_loop",
            "call",
            "jump"
          ]
        },
        "text": { "type": "string" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/block" },
          "description": "sequence: Blockfolge; count_loop/head_loop/foot_loop: Schleifenkörper."
        },
        "then": {
          "type": "array",
          "items": { "$ref": "#/$defs/block" },
          "description": "branch: Ja-Zweig."
        },
        "else": {
          "type": "array",
          "items": { "$ref": "#/$defs/block" },
          "description": "branch: Nein-Zweig."
        },
        "labels": {
          "type": "object",
          "description": "branch: abweichende Zweigbeschriftungen statt ja/nein.",
          "properties": {
            "then": { "type": "string" },
            "else": { "type": "string" }
          }
        },
        "cases": {
          "type": "array",
          "description": "multi_branch: Fälle der Mehrfachauswahl.",
          "items": {
            "type": "object",
            "required": ["label", "children"],
            "properties": {
              "label": { "type": "string" },
              "children": { "type": "array", "items": { "$ref": "#/$defs/block" } }
            }
          }
        }
      }
    },
    "tabellenzeile": {
      "type": "object",
      "required": ["text", "values"],
      "description": "Eine Bedingungs- oder Aktionszeile; ein Eintrag in values je Regel-Spalte (Abschnitt 13.5).",
      "properties": {
        "text": { "type": "string" },
        "values": { "type": "array", "items": { "type": "string" } }
      }
    },
    "shape": {
      "type": "object",
      "required": ["id", "kind", "x", "y", "w", "h"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "type": "string" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "w": { "type": "number" },
        "h": { "type": "number" },
        "text": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "attributes": { "type": "array", "items": { "type": "string" } },
            "methods": { "type": "array", "items": { "type": "string" } }
          }
        },
        "abstract": { "type": "boolean" },
        "fill": { "type": "string", "description": "Eigene Füllfarbe #RRGGBB statt der Stilvorlage." },
        "line": { "type": "string", "description": "Eigene Randfarbe #RRGGBB statt der Stilvorlage." },
        "font_size": { "type": "number", "description": "Eigene Schriftgröße in pt." }
      }
    },
    "connector": {
      "type": "object",
      "required": ["id", "kind", "from", "to"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "type": "string" },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "waypoints": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "labels": {
          "type": "object",
          "properties": {
            "from": { "type": "string" },
            "to": { "type": "string" }
          }
        }
      }
    }
  }
}
